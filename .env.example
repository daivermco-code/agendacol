# Copia este archivo como .env.local y pon los valores de tu Supabase.
# Con el Supabase local (`npm run db:start`), el CLI imprime la URL y las llaves al arrancar.

# URL de la API de Supabase. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Llave pública (anon). Va al navegador; las políticas RLS protegen los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-llave-anon

# Llave de servicio (secreta, solo servidor y scripts). Nunca la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=tu-llave-service-role

# Contraseña de los usuarios de demo que crea `npm run demo:usuarios` (elige una tuya).
DEMO_PASSWORD=cambia-esta-clave

# Solo para crear los usuarios de demo en un Supabase en la nube (scripts/usuarios-demo.mjs --nube).
# DEMO_PROYECTO_NUBE=https://tu-proyecto.supabase.co
